# ОСНОВНЫЕ
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# PYTHON
[*.py]
indent_style = space
indent_size = 4
max_line_length = 88

# ДАННЫЕ И РАЗМЕТКА
[*.{js,jsx,ts,tsx,json,jsonc,yml,yaml,html,css,scss,toml}]
indent_size = 2

# MARKDOWN
[*.{md,markdown,rst,Rmd}]
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

# ПАТЧИ
[*.{diff,patch}]
trim_trailing_whitespace = false

# SHELL
[*.{sh,bash,zsh}]
indent_size = 2

# WINDOWS-СКРИПТЫ
[*.{bat,cmd,ps1}]
end_of_line = crlf

# MAKE
[Makefile]
indent_style = tab
indent_size = 4

[*.mk]
indent_style = tab
indent_size = 4
